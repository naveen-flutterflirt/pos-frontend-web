# ==============================================================================
# BizBox Web Admin - Environment Variables Template
# Copy this file to .env.local for local development, or configure in deployment platform
# ==============================================================================

# Backend Fastify REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# POS Terminal Web App Base URL (used for Hardware Hub, KDS launchers, token displays)
NEXT_PUBLIC_POS_URL=http://localhost:3001

# Web Admin Console Base URL
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# App Branding
NEXT_PUBLIC_APP_NAME="BizBox Cloud Admin"

