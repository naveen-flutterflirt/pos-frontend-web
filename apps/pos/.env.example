# ==============================================================================
# BizBox POS Terminal - Environment Variables Template
# Copy this file to .env.local for local development, or configure in deployment platform
# ==============================================================================

# Backend Fastify REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# Web Admin Console Base URL (used for "Switch to Admin" console link)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# POS Terminal Web App Base URL
NEXT_PUBLIC_POS_URL=http://localhost:3001

# Terminal Branding
NEXT_PUBLIC_APP_NAME="BizBox POS Terminal"

